<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center_vertical">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_launcher" android:contentDescription="@string/app_name"/>
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:text="@string/app_name" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageButton android:id="@+id/recheck" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="重新检查" android:padding="12dp" android:src="@drawable/ic_refresh" app:tint="@color/blue" android:visibility="gone"/>
        <Switch android:id="@+id/automaticSwitch" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="56dp" android:showText="false" android:contentDescription="@string/automatic_checkin" android:enabled="false"/>
    </LinearLayout>
    <TextView android:id="@+id/accessibilityNotice" style="@style/Body" android:paddingHorizontal="20dp" android:textColor="@color/warning" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
    <TextView android:id="@+id/error" style="@style/Body" android:paddingHorizontal="20dp" android:textColor="@color/warning" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
    <Button android:id="@+id/reload" style="@style/Action" android:text="重新加载" android:visibility="gone"/>
    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:background="@color/paper">
        <Button android:id="@+id/navPlan" style="@style/NavigationItem" android:drawableTop="@drawable/nav_plan" android:layout_width="0dp" android:layout_weight="1" android:text="@string/plan"/>
        <Button android:id="@+id/navRecords" style="@style/NavigationItem" android:drawableTop="@drawable/nav_records" android:layout_width="0dp" android:layout_weight="1" android:text="@string/records"/>
        <Button android:id="@+id/navMail" style="@style/NavigationItem" android:drawableTop="@drawable/nav_mail" android:layout_width="0dp" android:layout_weight="1" android:text="@string/mail"/>
        <Button android:id="@+id/navSettings" style="@style/NavigationItem" android:drawableTop="@drawable/nav_settings" android:layout_width="0dp" android:layout_weight="1" android:text="@string/settings"/>
    </LinearLayout>
</LinearLayout>
