<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="20dp">
<LinearLayout style="@style/Card"><TextView style="@style/Heading" android:text="邮件通知规则"/><TextView style="@style/Body" android:text="签到成功或失败后均发送通知邮件；结果无法确认或漏执行时按失败通知。"/></LinearLayout>
<LinearLayout style="@style/Card">
<TextView style="@style/Body" android:text="收件邮箱" android:labelFor="@id/recipient"/>
<EditText android:id="@+id/recipient" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textEmailAddress" android:maxLength="254" android:singleLine="true" android:hint="name@example.com" android:importantForAutofill="no"/>
<Button android:id="@+id/saveMail" style="@style/Primary" android:text="保存邮箱"/>
<TextView android:id="@+id/mailStatus" style="@style/Caption"/>
<Button android:id="@+id/testMail" style="@style/Action" android:text="发送测试邮件"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView style="@style/Heading" android:layout_width="0dp" android:layout_weight="1" android:text="邮件列表"/>
<ImageButton android:id="@+id/clearMail" style="@style/Action" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_clear_mail_history" android:contentDescription="清除邮件记录"/>
</LinearLayout>
<LinearLayout android:id="@+id/alerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<TextView style="@style/Caption" android:gravity="center_horizontal" android:text="设备关机或持续断网时无法主动发送通知。"/>
</LinearLayout></ScrollView>
