<resources>
    <style name="Theme.Niuma.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/blue</item>
        <item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/bg</item><item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item><item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Niuma" parent="Theme.Niuma.Base"/>
    <style name="Body"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">15sp</item><item name="android:textColor">@color/ink</item><item name="android:lineSpacingExtra">5dp</item><item name="android:paddingBottom">10dp</item></style>
    <style name="CheckDetail" parent="Body"><item name="android:textColor">@color/muted</item></style>
    <style name="Caption" parent="Body"><item name="android:textSize">13sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="Heading" parent="Body"><item name="android:textSize">19sp</item><item name="android:textStyle">bold</item></style>
    <style name="Card"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item><item name="android:padding">20dp</item><item name="android:layout_marginBottom">16dp</item><item name="android:background">@drawable/card</item></style>
    <style name="Action"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:textColor">@color/blue</item><item name="android:backgroundTint">@color/pale</item></style>
    <style name="Primary" parent="Action"><item name="android:textColor">@color/paper</item><item name="android:backgroundTint">@color/blue</item></style>
    <style name="NavigationItem" parent="Action">
        <item name="android:minHeight">72dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/nav_tint</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/nav_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
